# Diagnóstico do ambiente. Rode na raiz do repositório, antes de pedir ajuda:
#   cmake -P cmake/doctor.cmake
# É um script CMake (não um alvo do build) para funcionar mesmo quando o configure falha.

cmake_minimum_required(VERSION 3.21)
get_filename_component(ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(PROBLEMS 0)

# report(<variável> <mensagem ok> <mensagem de erro>): [ok] se a variável for verdadeira
macro(report var ok_message fail_message)
  if(${var})
    message("  [ok] ${ok_message}")
  else()
    message("  [!!] ${fail_message}")
    math(EXPR PROBLEMS "${PROBLEMS} + 1")
  endif()
endmacro()

# --- Sistema -----------------------------------------------------------------
message("== Sistema")
set(IS_WSL FALSE)
if(EXISTS /proc/version)
  file(READ /proc/version PROC_VERSION)
  string(TOLOWER "${PROC_VERSION}" PROC_VERSION)
  string(FIND "${PROC_VERSION}" "microsoft" WSL_POS)
  if(WSL_POS GREATER -1)
    set(IS_WSL TRUE)
  endif()
endif()
if(IS_WSL)
  message("  plataforma: ${CMAKE_HOST_SYSTEM_NAME} (WSL)")
  string(REGEX MATCH "^/mnt/" ROOT_IN_MNT "${ROOT}")
  if(ROOT_IN_MNT)
    set(ROOT_OK FALSE)
  else()
    set(ROOT_OK TRUE)
  endif()
  report(ROOT_OK "repo no filesystem do Linux"
    "repo em /mnt: o build fica lento. Prefira clonar em ~/ dentro do WSL")
else()
  message("  plataforma: ${CMAKE_HOST_SYSTEM_NAME}")
endif()

# --- Ferramentas -------------------------------------------------------------
message("== Ferramentas")
if(CMAKE_VERSION VERSION_GREATER_EQUAL 3.21)
  set(CMAKE_OK TRUE)
else()
  set(CMAKE_OK FALSE)
endif()
report(CMAKE_OK "cmake ${CMAKE_VERSION}" "cmake ${CMAKE_VERSION} é antigo: precisa de 3.21 ou mais novo")

find_program(GXX g++)
if(GXX)
  execute_process(COMMAND "${GXX}" -dumpfullversion OUTPUT_VARIABLE GXX_VERSION OUTPUT_STRIP_TRAILING_WHITESPACE)
  execute_process(COMMAND "${GXX}" -dumpmachine OUTPUT_VARIABLE GXX_MACHINE OUTPUT_STRIP_TRAILING_WHITESPACE)
endif()
if(CMAKE_HOST_WIN32)
  find_program(MAKE_PROGRAM mingw32-make)
  string(FIND "${GXX_MACHINE}" "mingw32" MINGW_POS)
  if(GXX AND MINGW_POS GREATER -1)
    set(GXX_OK TRUE)
  else()
    set(GXX_OK FALSE)
  endif()
  report(GXX_OK "g++ ${GXX_VERSION} (${GXX_MACHINE})"
    "g++ do MinGW-w64 não encontrado: adicione C:\\msys64\\ucrt64\\bin ao Path (docs/SETUP.md)")
  report(MAKE_PROGRAM "mingw32-make encontrado"
    "mingw32-make não encontrado: pacman -S mingw-w64-ucrt-x86_64-make (docs/SETUP.md)")
else()
  find_program(MAKE_PROGRAM make)
  report(GXX "g++ ${GXX_VERSION} (${GXX_MACHINE})" "g++ não encontrado: rode o apt install de docs/SETUP.md")
  report(MAKE_PROGRAM "make encontrado" "make não encontrado: rode o apt install de docs/SETUP.md")
endif()

# --- Bibliotecas embutidas ---------------------------------------------------
message("== Bibliotecas em lib/")
foreach(file glfw/src/init.c glad/src/gl.c glm/glm/glm.hpp stb/stb_image.h)
  if(EXISTS "${ROOT}/lib/${file}")
    set(LIB_OK TRUE)
  else()
    set(LIB_OK FALSE)
  endif()
  report(LIB_OK "lib/${file}" "lib/${file} ausente: o clone está incompleto")
endforeach()

# --- Linux: headers do X11 e display -----------------------------------------
if(CMAKE_HOST_UNIX)
  message("== Headers do X11 (usados pelo GLFW)")
  foreach(header Xlib.h extensions/Xrandr.h extensions/Xinerama.h Xcursor/Xcursor.h extensions/XInput2.h)
    if(EXISTS "/usr/include/X11/${header}")
      set(HEADER_OK TRUE)
    else()
      set(HEADER_OK FALSE)
    endif()
    report(HEADER_OK "X11/${header}" "X11/${header} ausente: rode o apt install de docs/SETUP.md")
  endforeach()

  message("== Display e OpenGL")
  set(DISPLAY_VALUE "$ENV{DISPLAY}")
  report(DISPLAY_VALUE "DISPLAY=${DISPLAY_VALUE}"
    "DISPLAY vazio: no WSL rode wsl --update e wsl --shutdown no PowerShell")

  find_program(GLXINFO glxinfo)
  if(GLXINFO AND DISPLAY_VALUE)
    execute_process(COMMAND "${GLXINFO}" -B OUTPUT_VARIABLE GLXINFO_OUT ERROR_QUIET)
    string(REGEX MATCH "OpenGL renderer string: [^\n]*" GL_RENDERER "${GLXINFO_OUT}")
    string(REGEX MATCH "OpenGL core profile version string: ([0-9]+\\.[0-9]+)" GL_CORE "${GLXINFO_OUT}")
    set(GL_CORE_VERSION "${CMAKE_MATCH_1}")
    message("  ${GL_RENDERER}")
    if(GL_CORE_VERSION VERSION_GREATER_EQUAL 3.3)
      set(GL_OK TRUE)
    else()
      set(GL_OK FALSE)
    endif()
    report(GL_OK "OpenGL core ${GL_CORE_VERSION} (o projeto precisa de 3.3)"
      "OpenGL core 3.3 indisponível (encontrado: '${GL_CORE_VERSION}'): veja Problemas comuns em docs/SETUP.md")
  else()
    report(GLXINFO "glxinfo encontrado" "glxinfo indisponível: sudo apt install mesa-utils")
  endif()
endif()

message("")
if(PROBLEMS EQUAL 0)
  message("Tudo certo. Compile com: cmake --preset <linux|windows> e cmake --build --preset <linux|windows> --target run")
else()
  message("${PROBLEMS} problema(s) acima. Veja docs/SETUP.md")
endif()
